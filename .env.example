# ─── Polymarket Scanner — Environment Config Template ───────────────────
# Copy this file to .env and configure your production credentials:
# cp .env.example .env

# Server Port (Default: 3001)
PORT=3001
NODE_ENV=production

# ─── PolyTest API (for Backtesting) ─────────────────────────────────────
# Get your key at: https://www.polytest.io (optional for live scanner)
POLYTEST_API_KEY=

# ─── Polymarket Builder / CLOB API (for Live Trading) ───────────────────
# Get your Builder Code at: https://polymarket.com/settings?tab=builder
POLY_BUILDER_CODE=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ─── Optional: Telegram / Discord Alerts (if configured) ─────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
